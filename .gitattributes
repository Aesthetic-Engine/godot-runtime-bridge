# Normalize line endings for all files that Git considers text files.
* text=auto eol=lf

# GitHub Download ZIP, AssetLib, and git archive are addon-install
# surfaces. Keep the MCP/CLI/proof workflow in a full git clone.
# AssetLib computes its download URL from a commit/tag, so export-ignore
# is the supported way to keep those computed archives project-safe.
/**            export-ignore
/addons        !export-ignore
/addons/**     !export-ignore
/missions      !export-ignore
/missions/**   !export-ignore
