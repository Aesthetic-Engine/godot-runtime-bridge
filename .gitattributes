# Normalize line endings for all files that Git considers text files.
* text=auto eol=lf

# Export/archive output is intentionally addon-oriented, not a full-repo
# distribution of the GRB 2.0 tooling surface.
# Only include the addons folder when downloading from the Asset Library.
/**            export-ignore
/addons        !export-ignore
/addons/**     !export-ignore
/missions      !export-ignore
/missions/**   !export-ignore
