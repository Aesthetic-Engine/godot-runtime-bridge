config_version=5

[application]

config/name="GRB 2.0 Proving Ground"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[autoload]

GRBServer="*res://addons/godot-runtime-bridge/runtime_bridge/DebugServer.gd"
GRBCommands="*res://addons/godot-runtime-bridge/runtime_bridge/GRBCommands.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
